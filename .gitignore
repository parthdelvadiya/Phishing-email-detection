# ==============================================================================
# PhishGuard — Root .gitignore
# Covers Python, Django, Virtual Environments, Node.js, React/Vite, IDEs, and OS
# ==============================================================================

# --- Virtual Environments ---
venv/
*/venv/
.venv/
*/.venv/
env/
*/env/
ENV/
*/ENV/
env.bak/
venv.bak/

# --- Python & Bytecode ---
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Django & Databases ---
*.sqlite3
*.sqlite3-journal
db.sqlite3
Backend/db.sqlite3
local_settings.py
staticfiles/
media/
*.log

# --- Node.js & Frontend ---
node_modules/
*/node_modules/
Frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store

# --- Build Outputs ---
Frontend/dist/
Frontend/dist-ssr/
dist/
build/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
Backend/.env
Backend/.env.*
!Backend/.env.example
*.local

# --- Editor & IDE Files ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Temporary and Cache Files ---
*.tmp
*.bak
*.cache

# --- Datasets & Raw Training Data (Exceeds GitHub size limits) ---
Backend/data/
*.tar.bz2
*.tar.gz
*.zip
*.npy
*.npz
*.csv
cache_cleaned_texts.json
cache_struct_matrix.npy


